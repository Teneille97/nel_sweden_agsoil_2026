   journal = {Bulgarian Chemical Communications},
   keywords = {FTIR,Kidney stones,Vibrational assignment,XRD},
   pages = {88-95},
   title = {Application of vibrational spectroscopy and XRD analysis for investigation of calcium oxalate kidney stones},
