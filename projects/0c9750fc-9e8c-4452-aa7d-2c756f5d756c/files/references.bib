@article{Milton1994,
   abstract = {Struthio camelus were studied in southern African savanna, desert grassland, arid shrubland, and fynbos. Ostrich fed on green annual grasses and forbs when available. When these were not available they consumed leaves, flowers and fruits from succulents and woody plants. Ostrich selected for fiber and against phenolics in forbs. They preferred protein in graminoids and fiber in succulents, but avoided calcium in succulents. They selected sodium and avoided ether-extractable substances in woody plants. Ostrich need 5-6 kg fresh mass daily when feeding on natural forage containing 70% water for maintenance. Ostrich mobility and selectivity, which enables them to obtain adequate, high quality forage in arid environments, makes them destructive to rangeland when confined and stocked at high densities. -from Authors},
