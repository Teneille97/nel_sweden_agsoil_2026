   author = {Amin Sharififar and Budiman Minasny and Dominique Arrouays and Line Boulonne and Tiphaine Chevallier and Piet van Deventer and Damien J. Field and Cécile Gomez and Ho-Jun Jang and Sang-Ho Jeon and Jaco Koch and Alex B. McBratney and Brendan P. Malone and Ben P. Marchant and Manuel P. Martin and Curtis Monger and José-Luis Munera-Echeverri and José Padarian and Marco Pfeiffer and Anne C. Richer-de-Forges and Nicolas P.A. Saby and Kanika Singh and Xiao-Dong Song and Kazem Zamanian and Gan-Lin Zhang and George van Zijl},
